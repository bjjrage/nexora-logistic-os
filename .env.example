# Copiar a .env; las credenciales quedan únicamente en el servidor.
# npm start / dev:api / preview cargan .env desde el servidor. No usar prefijo VITE_.
# En un alojamiento con proxy HTTPS, HOST=0.0.0.0. Por defecto solo acceso local.
HOST=127.0.0.1
PORT=3001
DATABASE_PROVIDER=postgres
DATABASE_URL=
DATABASE_SCHEMA=nexora
SUPABASE_URL=
# Opcional: otra CA del proveedor; por defecto usa el certificado público incluido.
PGSSLROOTCERT=
# QuadMinds se habilita cuando entregue el contrato de tracking.
QUADMINDS_ENABLED=false
QUADMINDS_ORG_ID=
QUADMINDS_POSITION_URL=
QUADMINDS_API_KEY=
# JSON con rutas de campos del payload confirmado, sin valores inventados.
QUADMINDS_FIELDS=
# Ruta al objeto o lista de posiciones dentro del JSON; vacío si está en la raíz.
QUADMINDS_ITEMS_PATH=
# Ajustar a los límites acordados con QuadMinds.
QUADMINDS_POLL_INTERVAL_MS=30000
QUADMINDS_STALE_AFTER_MS=180000
QUADMINDS_TIMEOUT_MS=8000
# Integración de órdenes, rutas publicadas y comprobantes (API SaaS v2).
QUADMINDS_OPERATIONS_ENABLED=false
QUADMINDS_WEBHOOK_SECRET=
# Hosts exactos HTTPS confirmados por QuadMinds; descarga privada sin redirecciones.
QUADMINDS_PROOF_HOSTS=
# Arrays JSON de códigos numéricos confirmados del producto contratado; no inferir por texto.
QUADMINDS_DELIVERED_CODES=[]
QUADMINDS_FAILED_CODES=[]
# Dimensiones definidas en la cuenta: [{"id":123,"source":"WEIGHT_KG"}].
# Fuentes: WEIGHT_KG, VOLUME_M3, UNITS. IDs del proveedor, no valores ficticios.
QUADMINDS_CONSTRAINTS=[]
# En producción: origen HTTPS exacto del OS, separado por comas si hay varios.
ALLOWED_ORIGINS=
COOKIE_SECURE=true
# Secreto privado (mínimo 32 caracteres) para /api/jobs/quadminds-sync.
CRON_SECRET=
# Alta inicial por defecto bloqueada en producción. Crear admin desde local/Supabase primero.
INITIAL_SETUP_TOKEN=
# Observabilidad: identificador del commit desplegado y número exacto de proxies confiables.
RELEASE_SHA=
# Detrás de Vercel→Railway suele ser 2; con 0 el límite de login usa la IP del proxy y todos comparten cupo.
TRUST_PROXY_HOPS=0
LOG_HTTP=false
# Backup local privado; pg_dump debe ser de la misma versión mayor o posterior a PostgreSQL.
PG_DUMP_BIN=
BACKUP_DIR=.local/backups
# Monitor: canal HTTPS privado opcional. Sin canal, registra alertas locales; no envía correo.
OS_MONITOR_URL=http://127.0.0.1:5173/api/ready
# También recibe errores 500 y caídas del servidor (solo metadatos, máx. 1/min por tipo).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
TRACCAR_ENABLED=false
# Pasarela HTTPS de Railway; secreto únicamente en el servidor del OS.
TRACCAR_GATEWAY_URL=
TRACCAR_GATEWAY_SECRET=
# URL HTTPS del puerto OsmAnd (5055), usada por los teléfonos.
TRACCAR_PHONE_URL=
